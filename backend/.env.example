# Application Settings
APP_NAME=Sales AI Pipeline
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Local execution uses localhost; Docker Compose overrides only the host to `postgres`.
POSTGRES_USER=salesai
POSTGRES_PASSWORD=salesai_password
POSTGRES_DB=salesai_db
DATABASE_URL=postgresql://salesai:salesai_password@localhost:5432/salesai_db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=5

# API protection and operational limits
API_AUTH_TOKEN=your-local-api-token
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LEAD_REQUESTS=10
RATE_LIMIT_PROPOSAL_REQUESTS=30
RATE_LIMIT_KB_UPLOADS=10
WEB_SEARCH_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=120
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# LLM Configuration
LLM_PROVIDER=gemini  # gemini, groq, openrouter, anthropic, openai, google
# Used only after a quota response from the selected provider. Configured providers only.
LLM_FALLBACK_PROVIDERS=groq
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=your-groq-api-key

# LLM Models
LLM_MODEL_MAIN=gemini-3.6-flash
LLM_MODEL_REASONING=gemini-3.6-flash
# Required only when LLM_PROVIDER=openrouter. Use an OpenRouter model ID.
OPENROUTER_MODEL_MAIN=
OPENROUTER_MODEL_REASONING=
# Required only when LLM_PROVIDER=groq. Uses Groq's OpenAI-compatible API.
GROQ_MODEL_MAIN=llama-3.3-70b-versatile
GROQ_MODEL_REASONING=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7

# Web Search
BRAVE_SEARCH_API_KEY=your-brave-search-key
SERPER_API_KEY=your-serper-api-key

# Knowledge Base
KNOWLEDGE_BASE_PATH=knowledge_base
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Real SMTP Email Delivery Configuration
# For Gmail, set SMTP_USER to your Gmail address and SMTP_PASSWORD to a 16-character App Password.
# (Generate at: Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

